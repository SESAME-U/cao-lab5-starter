# Copy to .env (ignored by Git) and change the passwords.
# scripts/up.sh passes these to the containers with --env-file: they are
# never written into the image or into Git.
DB_ROOT_PASSWORD=change-me-root
DB_NAME=shop
DB_USER=shop
DB_PASSWORD=change-me-shop
SHOP_PORT=8080
SHOP_IMAGE=cao-shop:1.0
SHOP_ADMIN_PASSWORD=change-me-admin
